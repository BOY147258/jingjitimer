# 竞迹计时系统 - 环境变量配置
# 复制此文件为 .env 并填入实际值

# ============ 服务器配置 ============
PORT=8080
HOST=0.0.0.0
BASE_URL=http://localhost:8080

# ============ 数据库配置 ============
DB_PATH=./data/jingjitimer.db
DB_ENABLE_WAL=true

# ============ 日志配置 ============
LOG_LEVEL=info
LOG_FILE=./logs/app.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=7

# ============ 安全配置 ============
CORS_ORIGIN=*
ALLOWED_ORIGINS=http://localhost:8080,https://boy147258.github.io
SESSION_SECRET=your-secret-key-change-this

# ============ WebSocket 配置 ============
WS_PORT=8080
WS_PING_INTERVAL=30000
WS_TIMEOUT=60000
WS_MAX_CONNECTIONS=100

# ============ API 配置 ============
API_PREFIX=/api
API_RATE_LIMIT=100
API_RATE_WINDOW=60000

# ============ 功能开关 ============
ENABLE_ANALYTICS=false
ENABLE_CRASH_REPORT=false
ENABLE_NOTIFICATIONS=true

# ============ 存储配置 ============
DATA_DIR=./data
TEMP_DIR=./temp
BACKUP_DIR=./backups
MAX_VIDEO_SIZE=500

# ============ 部署配置 ============
DEPLOY_MODE=production
RENDER=true
RENDER_PORT=10000
